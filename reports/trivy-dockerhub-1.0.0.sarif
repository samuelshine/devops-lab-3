            {
              "id": "CVE-2026-6368",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "glibc: glibc: Process abort due to invalid memory in wordexp"
              },
              "fullDescription": {
                "text": "Calling wordexp with WRDE_APPEND in the GNU C Library version 2.0 to version 2.43 can cause the interface to return invalid memory in the we_wordv member, which on subsequent calls to wordfree may abort the process."
